{
  "name": "AIscend",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install -r requirements.txt",
  "postStartCommand": "nohup python web_app.py >/tmp/aiscend-web.log 2>&1 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "AIscend Web",
      "onAutoForward": "openBrowser"
    }
  }
}
